Output demo.gif
Set Theme "Catppuccin Mocha"
Set Padding 4
Set Width 1200
Set Height 700
Set FontSize 14
Set PlaybackSpeed 1.1

Type "eddn-tail"
Sleep 0.5s
Enter

# Let messages stream in
Sleep 4s

# Pause the stream
Type "p"

Sleep 1s

# Open the live filter
Type "/"

Sleep 0.5s
Type "Scan"
Sleep 0.5s

# Submit the filter
Enter

# Wait to show filtered results
Sleep 2s

# Navigate up to a row
Up
Up
Up

Sleep 0.5s

# Select a row to view detail
Enter

# Admire the detail pane
Sleep 3s

# Clear the filter
Escape

Sleep 1s

# Toggle detail pane off
Type "d"

Sleep 1s

# Quit
Type "q"
